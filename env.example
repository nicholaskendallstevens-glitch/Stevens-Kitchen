# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional but recommended: enables photo import, pasted-text import,
# fallback for sites without structured data, and translation to English.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5

# App name shown in the UI and on the iPhone home screen
NEXT_PUBLIC_APP_NAME=Stevens Kitchen

# Comma-separated emails allowed to use the app (extra safety on top of disabled sign-ups)
ALLOWED_EMAILS=nicholas@example.com,geraldine@example.com
